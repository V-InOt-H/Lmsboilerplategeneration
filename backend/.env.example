# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI= # MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zoho-lms add your mongodb atlas cluster link

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Email Configuration (using Gmail as example)
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Zoho Learning <noreply@zoholearning.com>

# For other email services (SendGrid, Mailgun, etc.)
# EMAIL_SERVICE=sendgrid
# EMAIL_USERNAME=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

